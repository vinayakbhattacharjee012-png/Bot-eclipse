# Copy this file to .env and fill in your own values. Never commit the real .env file.

# Your bot's token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# Optional: restrict slash command sync to one server while testing (much faster than global sync).
# Right-click your server icon in Discord (with Developer Mode on) -> Copy Server ID.
DEV_GUILD_ID=

# Optional: a channel ID the bot posts its startup message and crash reports to.
OWNER_LOG_CHANNEL_ID=

# Optional: AI assistant (/ai ask, summarize, code, research). Any OpenAI-compatible chat endpoint.
# All three must be set, or the AI commands show a setup message. Keep AI_API_KEY secret.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
